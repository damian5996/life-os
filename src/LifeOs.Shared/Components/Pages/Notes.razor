@page "/"
@inject LifeOsApiClient Api
@inject IServiceProvider Services
@implements IDisposable
<PageTitle>Notatki · Life OS</PageTitle>
@if (message is not null) { <p class="notice" role="status">@message</p> }
@if (selected is not null)
{
    <button class="back" disabled="@changing" @onclick="BackToList">← Wróć do notatek</button>
    <CaptureDetails Capture="selected" />
    <div class="capture-actions">
        @if (error is not null) { <p class="notice warning" role="alert">@error</p> }
        @if (selected.DeletedAt is not null)
        {
            <p class="muted">Ta notatka jest w koszu i nie trafia do podsumowań.</p>
            <button class="restore-button" disabled="@changing" @onclick="() => ChangeDeletedState(false)">@(changing ? "Przywracanie…" : "Przywróć notatkę")</button>
        }
        else
        {
            <button class="delete-button" disabled="@changing" @onclick="() => ChangeDeletedState(true)">@(changing ? "Usuwanie…" : "Usuń notatkę")</button>
            <p class="muted">Notatka trafi do kosza. Możesz ją później przywrócić.</p>
        }
    </div>
}
else if (adding)
{
    <button class="back" disabled="@saving" @onclick="() => adding = false">← Wróć do notatek</button>
    <span class="eyebrow">ZATRZYMAJ MYŚL</span><h1>Dodaj notatkę</h1>
    <p class="intro">Pisz tak, jak myślisz. Resztę uporządkuje Life OS.</p>
    <form @onsubmit="Save" @onsubmit:preventDefault class="paper capture-form">
        <label for="capture-text">Co chcesz zapamiętać?</label>
        <textarea id="capture-text" @bind="text" @bind:event="oninput" disabled="@saving" rows="8"
                  placeholder="Dzisiaj zauważyłem…" required></textarea>
        <p class="muted">Nie musisz wybierać kategorii ani poprawiać interpunkcji.</p>
        @if (error is not null) { <p class="notice warning" role="alert">@error</p> }
        <button class="primary" type="submit" disabled="@(saving || string.IsNullOrWhiteSpace(text))">@(saving ? "Zapisywanie i porządkowanie…" : "Zapisz")</button>
        @if (saving) { <p role="status" class="muted">To może potrwać chwilę. Poczekaj na potwierdzenie.</p> }
    </form>
}
else
{
    <div class="page-heading"><div><span class="eyebrow">TWOJA CODZIENNOŚĆ, ZAPISANA</span><h1>@(showTrash ? "Kosz" : "Notatki")</h1>
        <p class="intro">Myśli, pomysły i małe odkrycia. W jednym miejscu.</p></div>
        <button class="primary add-button" @onclick="StartAdding">+ Dodaj notatkę</button></div>
    <button class="trash-toggle" aria-pressed="@showTrash" @onclick="ToggleTrash">@(showTrash ? "Wróć do aktywnych notatek" : "Pokaż kosz")</button>
    <button class="refresh-button" disabled="@loading" @onclick="Load">Odśwież</button>
    <div class="filters" role="group" aria-label="Filtruj według typu">
        @if (customCategories)
        {
            <button class="@(activeCategory is null ? "chosen" : "")" @onclick="() => FilterCategory(null)">Wszystkie</button>
            @foreach (var category in categories)
            {
                <button class="@(activeCategory == category.Id ? "chosen" : "")" @onclick="() => FilterCategory(category.Id)">@category.Name@(!category.Enabled ? " (archiwalna)" : "")</button>
            }
        }
        else { @foreach (var filter in PolishLabels.Filters)
        {
            <button class="@(activeType == filter.Type ? "chosen" : "")" aria-pressed="@(activeType == filter.Type)"
                    @onclick="() => Filter(filter.Type)">@filter.Label</button>
        }
        }
    </div>
    <div class="export-actions" aria-label="Eksport notatek">
        @if (exportDestination is null)
        {
            <a class="download-button" href="@ExportUrl("markdown")" download data-enhance-nav="false" target="_blank" rel="noopener">Pobierz notatki (.md)</a>
            <a class="download-button" href="@ExportUrl("json")" download data-enhance-nav="false" target="_blank" rel="noopener">Pobierz dane (.json)</a>
        }
        else
        {
            <button class="export-markdown" disabled="@exporting" @onclick='() => Export("markdown")'>Udostępnij notatki (.md)</button>
            <button class="export-json" disabled="@exporting" @onclick='() => Export("json")'>Udostępnij dane (.json)</button>
        }
        @if (exporting) { <p role="status">Pobieranie eksportu…</p> }
        @if (exportError is not null) { <p class="notice warning" role="alert">@exportError</p> }
        <p class="muted">Eksport obejmuje wszystkie notatki @(showTrash ? "z kosza" : "poza koszem") pasujące do wybranego typu, bez limitu 100 — także oczekujące i z błędem AI.</p>
    </div>
    <div class="list-heading"><span>@(showTrash ? "NOTATKI W KOSZU" : "OSTATNIE NOTATKI")</span><span>Do 100 najnowszych · czas polski</span></div>
    @if (loading) { <p class="empty" role="status">Wczytywanie notatek…</p> }
    else if (error is not null)
    {
        <div class="notice warning" role="alert"><p>@error</p><button @onclick="Load">Spróbuj ponownie</button></div>
    }
    else if (showTrash && captures.Length == 0)
    {
        <div class="empty"><h2>Brak notatek w koszu dla wybranego filtra</h2><p>Usunięte notatki możesz tutaj przywrócić.</p></div>
    }
    else { <CaptureList Captures="captures" OnSelect="Open" /> }
}
@code {
    private Capture[] captures = [];
    private Capture? selected;
    private CaptureType? activeType;
    private Guid? activeCategory;
    private NoteCategory[] categories = [];
    private bool customCategories => Services.GetService<UiEnvironment>()?.AdministrationEnabled == true;
    private bool loading = true, adding, saving, changing, showTrash;
    private string text = "";
    private string? error, message;
    private int loadVersion;
    private string ExportUrl(string format) => LifeOsApiClient.ExportPath(format, activeType, showTrash, activeCategory);
    private IExportDestination? exportDestination;
    private CaptureChanges? changes;
    private bool exporting, disposed;
    private string? exportError;
    protected override async Task OnInitializedAsync()
    {
        exportDestination = Services.GetService<IExportDestination>();
        changes = Services.GetService<CaptureChanges>();
        if (changes is not null) changes.Changed += OnCapturesChanged;
        await Load();
    }
    private void OnCapturesChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed || selected is not null || adding) return;
        await Load();
        StateHasChanged();
    });
    public void Dispose() { disposed = true; if (changes is not null) changes.Changed -= OnCapturesChanged; }
    private async Task Export(string format)
    {
        if (exporting || exportDestination is null) return;
        exporting = true; exportError = null;
        try { await exportDestination.ShareAsync(await Api.DownloadExportAsync(format, activeType, showTrash, activeCategory)); }
        catch (UiApiException e) { exportError = e.Message; }
        catch (Exception) { exportError = "Nie udało się udostępnić pliku. Spróbuj ponownie."; }
        finally { exporting = false; }
    }
    private async Task Load()
    {
        var version = ++loadVersion;
        loading = true; error = null;
        try
        {
            if (customCategories) categories = await Api.GetCategoriesAsync();
            var result = await Api.GetCapturesAsync(activeType, showTrash, activeCategory);
            if (version == loadVersion) captures = result;
        }
        catch (UiApiException e) { if (version == loadVersion) error = e.Message; }
        finally { if (version == loadVersion) loading = false; }
    }
    private async Task Filter(CaptureType? type) { activeType = type; await Load(); }
    private async Task FilterCategory(Guid? id) { activeCategory = id; activeType = null; await Load(); }
    private void Open(Capture capture) { selected = capture; message = null; error = null; }
    private async Task ToggleTrash() { showTrash = !showTrash; activeType = null; message = null; await Load(); }
    private async Task ChangeDeletedState(bool delete)
    {
        if (changing || selected is null) return;
        changing = true; error = null;
        try
        {
            if (delete) await Api.DeleteCaptureAsync(selected.Id);
            else await Api.RestoreCaptureAsync(selected.Id);
            selected = null;
            message = delete ? "Przeniesiono notatkę do kosza. Możesz ją stamtąd przywrócić." : "Przywrócono notatkę.";
            await Load();
        }
        catch (UiApiException e) { error = e.Message; }
        finally { changing = false; }
    }
    private void StartAdding() { adding = true; error = null; message = null; }
    private async Task BackToList() { selected = null; message = null; await Load(); }
    private async Task Save()
    {
        if (saving || string.IsNullOrWhiteSpace(text)) return;
        saving = true; error = null;
        try
        {
            selected = await Api.CreateCaptureAsync(text);
            message = selected.ProcessingState == ProcessingState.COMPLETED ? "Zapisano." :
                "Zapisano oryginał. Klasyfikacja nie została ukończona — notatka nie pojawi się na liście ani w podsumowaniu.";
            text = ""; adding = false;
        }
        catch (UiApiException e) { error = e.Message; }
        finally { saving = false; }
    }
}
