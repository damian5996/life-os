@inherits LayoutComponentBase
@inject IServiceProvider Services
<a class="skip-link" href="#main">Przejdź do treści</a>
<header class="topbar">
    <a class="brand" href="/">life<span>os</span><small>MAŁE OBSERWACJE. TWOJE ŻYCIE.</small></a>
    <nav aria-label="Nawigacja główna">
        <NavLink href="/" Match="NavLinkMatch.All">Notatki</NavLink>
        <NavLink href="podsumowania">Podsumowania</NavLink>
        @if (Environment?.AdministrationEnabled == true) { <NavLink href="administracja">Administracja</NavLink> }
    </nav>
</header>
@if (Environment is not null) { <p class="environment-banner">LifeOS @Environment.Name · dane testowe</p> }
<main id="main" class="container">@Body</main>
<footer>Life OS <span>·</span> Miejsce na to, co zauważasz.</footer>
@code { private UiEnvironment? Environment => Services.GetService<UiEnvironment>(); }
