<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Razor" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- .NET 10.0.3xx otherwise adds the desktop host RID when Release trimming is enabled. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>LifeOs.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Life OS</ApplicationTitle>
    <ApplicationId>pl.lifeos.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion>
    <ApplicationVersion>6</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifeOsEnvironment)' == 'Development'">
    <ApplicationTitle>LifeOS Dev</ApplicationTitle>
    <ApplicationId>pl.lifeos.mobile.dev</ApplicationId>
    <DefineConstants>$(DefineConstants);LIFEOS_DEV</DefineConstants>
    <AndroidManifest>Platforms/Android/AndroidManifest.Dev.xml</AndroidManifest>
  </PropertyGroup>
  <Target Name="ValidateLifeOsEnvironment" BeforeTargets="PrepareForBuild"
          Condition="'$(LifeOsEnvironment)' != '' and '$(LifeOsEnvironment)' != 'Production' and '$(LifeOsEnvironment)' != 'Development'">
    <Error Text="LifeOsEnvironment must be Production or Development." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <ProjectReference Include="../LifeOs.Shared/LifeOs.Shared.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#173C35" Condition="'$(LifeOsEnvironment)' != 'Development'" />
    <MauiIcon Include="Resources/DevIcon/appicon.svg" Color="#7039A8" Condition="'$(LifeOsEnvironment)' == 'Development'" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#173C35" BaseSize="128,128" />
    <EmbeddedResource Include="appsettings.json" Condition="'$(LifeOsEnvironment)' != 'Development'" />
    <EmbeddedResource Include="appsettings.Dev.json" LogicalName="LifeOs.Mobile.appsettings.json" Condition="'$(LifeOsEnvironment)' == 'Development'" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Razor" />
  <!-- Override after MAUI SingleProject imports, which set their own default manifest. -->
  <PropertyGroup Condition="'$(LifeOsEnvironment)' == 'Development'">
    <AndroidManifest>Platforms\Android\AndroidManifest.Dev.xml</AndroidManifest>
  </PropertyGroup>
</Project>
